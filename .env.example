# ============ REQUIRED ============

# MongoDB Atlas — Database → Connect → Drivers → copy the connection string
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="nexovate"

# Public site URL (used in emails, sitemap, proposal links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Session signing secret — at least 32 random characters. Generate: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# First Super Admin. The first time you sign in at /login with exactly these
# details, the Super Admin account is created. Password: at least 10 characters.
ADMIN_EMAIL="you@nexovate.solutions"
ADMIN_PASSWORD="choose-a-strong-password"

# ============ OPTIONAL (features stay off until filled) ============

# Public contact details — empty = hidden on the site
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_WHATSAPP=""     # international format, e.g. +923001234567
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_FACEBOOK=""
NEXT_PUBLIC_SOCIAL_X=""

# Email (Resend — resend.com). Without a key, emails are printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="Nexovate <no-reply@nexovate.solutions>"   # domain must be verified in Resend
ADMIN_NOTIFY_EMAIL=""                                 # where new lead/order/ticket alerts go

# AI (website assistant + lead qualification). Both key and model are required.
AI_PROVIDER="anthropic"     # anthropic | openai
AI_API_KEY=""
AI_MODEL=""                 # the exact model id from your provider's docs

# Payments — manual bank transfer / payout instructions shown after checkout.
# Use only real, verified account details. Use \n for new lines.
PAYMENT_MANUAL_INSTRUCTIONS=""

# Consultation booking (business hours in BOOKING_TIMEZONE)
BOOKING_TIMEZONE="Asia/Karachi"
BOOKING_WEEKDAYS="1,2,3,4,5"     # 0=Sun … 6=Sat
BOOKING_START_HOUR="10"
BOOKING_END_HOUR="18"
BOOKING_SLOT_MINUTES="30"
BOOKING_DAYS_AHEAD="14"
BOOKING_MIN_NOTICE_MINUTES="240"
BOOKING_MEETING_LINK=""          # e.g. your Google Meet / Zoom room link
